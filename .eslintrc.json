{
  "root": true,
  "extends": "wikimedia/server",
  "ignorePatterns": ["npm-shrinkwrap.json"],
  "rules": {
    "strict": "off"
  },
  "overrides": [
    {
      "files": ["**/*.json"],
      "rules": {
        "array-bracket-spacing": "off",
        "comma-spacing": "off",
        "eol-last": "off",
        "indent": "off",
        "key-spacing": "off"
      }
    }
  ]
}
